<header data-header>
  <div class="header-content" data-au="flex-container align-center">
    <!-- pixel logo -->
    <div class="header-logo-container" data-au="flex-width flex-container align-center">
      <a data-au="set-width" href="https://www.pixelplanettoday.com" aria-label="Pixel Planet Today home">
        <div class="header-logo ppt-logo" data-au="set-width"></div>
      </a>
    </div>
    <div data-mobile-menu-trigger data-adaptive="mobile" data-au="flex-container all-center">
      <a class="mobile-menu-icon" aria-label="Toggle mobile navigation"></a>
    </div>
    <nav data-adaptive="tablet desktop" data-au="set-width flex-container align-center">
      <a class="{% if navSelected == 'home' %}selected{% endif %}" href="/">Home</a>
      <!-- <a class="" href="/links/index.html">Links</a> -->
      <a class="{% if navSelected == 'shop' %}selected{% endif %}" href="https://shop.pixelplanettoday.com">Shop</a>
      <a class="{% if navSelected == 'blog' %}selected{% endif %}" href="https://blog.pixelplanettoday.com">Blog</a>
    </nav>
  </div>
</header>